# Copy outside the Git checkout to a root-only file before deployment.
# Keep values empty in this example. Never commit the populated file.

# Required Gateway client authentication.
CASPER_OMBRE_GATEWAY_TOKEN=

# Required Brain internal hook authentication; must be distinct from Gateway token.
CASPER_INTERNAL_HOOK_TOKEN=

# Required OpenRouter upstream chat credential.
CASPER_OPENROUTER_API_KEY=

# Required remote dehydration/compression/tagging provider.
CASPER_DEHYDRATION_API_KEY=
CASPER_DEHYDRATION_BASE_URL=
CASPER_DEHYDRATION_MODEL=

# Required remote embedding provider.
CASPER_EMBEDDING_API_KEY=
CASPER_EMBEDDING_BASE_URL=
CASPER_EMBEDDING_MODEL=

# Optional initially: reranker is disabled in config.yaml.
CASPER_RERANKER_API_KEY=
CASPER_RERANKER_BASE_URL=
CASPER_RERANKER_MODEL=

# Required for minimal Persona relationship/session-affect continuity.
CASPER_PERSONA_API_KEY=
CASPER_PERSONA_BASE_URL=
CASPER_PERSONA_MODEL=

# Optional initially: all derived workers below are disabled.
CASPER_REFLECTION_API_KEY=
CASPER_REFLECTION_BASE_URL=
CASPER_REFLECTION_MODEL=
CASPER_PORTRAIT_API_KEY=
CASPER_PORTRAIT_BASE_URL=
CASPER_PORTRAIT_MODEL=
CASPER_DREAM_API_KEY=
CASPER_DREAM_BASE_URL=
CASPER_DREAM_MODEL=

# Optional and initially unreachable from the host because Brain is not published.
CASPER_DASHBOARD_PASSWORD=
CASPER_CHATGPT_OAUTH_CLIENT_ID=
CASPER_CHATGPT_OAUTH_CLIENT_SECRET=
CASPER_CHATGPT_OAUTH_ACCESS_TOKEN=
CASPER_CHATGPT_OAUTH_REFRESH_TOKEN=
CASPER_CHATGPT_OAUTH_PUBLIC_BASE_URL=
CASPER_CHATGPT_OAUTH_PROTECTED_HOSTS=
