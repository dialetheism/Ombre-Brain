FROM python@sha256:a249c9f47e05708dd367f3fe8ada03cf347390fad66fb8b0518c0ef55ae3cb84

ARG SOURCE_REPOSITORY=https://github.com/Yinglianchun/Ombre-Brain.git
ARG SOURCE_SHA=284c9c7b0e51a0ba0032c7028f705d72458cb304

LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${SOURCE_SHA}" \
      com.ombre.deployment="casper-ombre"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

WORKDIR /app

COPY casper-deploy/requirements.production.linux-amd64-py312.lock.txt ./requirements.production.linux-amd64-py312.lock.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check --require-hashes --only-binary=:all: --no-binary=jieba -r requirements.production.linux-amd64-py312.lock.txt

COPY --chown=10001:10001 *.py ./
COPY --chown=10001:10001 resources ./resources
COPY --chown=10001:10001 scripts ./scripts
COPY --chown=10001:10001 dashboard.html ./
COPY --chown=10001:10001 dashboard_assets ./dashboard_assets
COPY --chown=10001:10001 config.example.yaml ./config.yaml

RUN chmod +x scripts/*.sh

USER 10001:10001

EXPOSE 8000 8010

CMD ["python", "server.py"]
